use nix::unitd::{fork,ForkResualt,getpid,getppid};


fn main() {
    get_parent_child_pids();
    // proper_fork_one();
    // fork_and_exec_application();
}


fn get_parent_child_pids(){
    unsafe{
        let pid = fork();
        if pid == 0{
            println!("Child Process: {}",getpid());
        }else {
            println!("Parent Process: {}",getpid());
        }
    }
// Y: Practice: fork exec wait pipe dup epoll |
// Trace them using: strace ls
// strace ./target/debug/<ProgrameName>
}

